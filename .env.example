# Copy this file to .env and fill in your own values. Never commit .env.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase storage for uploaded documents
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# Authentication (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL=""
EMAIL_DEV_FALLBACK="true"

# Chatbot
NEXT_PUBLIC_CHATBOT_ENABLED="false"

# First admin account (used by: npm run seed:admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
